from collections import deque

def water_jug():
    visited = set()
    q = deque([((0,0), [])])

    while q:
        (x,y), path = q.popleft()

        if y == 2:
            print(path + [(x,y)])
            return

        if (x,y) in visited:
            continue

        visited.add((x,y))

        next_states = [
            (4,y),
            (x,3),
            (0,y),
            (x,0),
            (x-min(x,3-y), y+min(x,3-y)),
            (x+min(y,4-x), y-min(y,4-x))
        ]

        for state in next_states:
            q.append((state, path+[(x,y)]))

water_jug()
