from collections import deque

goal = [1, 2, 3, 4, 5, 6, 7, 8, 0]

def get_neighbors(state):
    neighbors = []
    idx = state.index(0)

    moves = {
        0:[1,3], 1:[0,2,4], 2:[1,5],
        3:[0,4,6], 4:[1,3,5,7], 5:[2,4,8],
        6:[3,7], 7:[4,6,8], 8:[5,7]
    }

    for m in moves[idx]:
        new = state[:]
        new[idx], new[m] = new[m], new[idx]
        neighbors.append(new)

    return neighbors

def bfs(start):
    q = deque([(start, [])])
    visited = set()

    while q:
        state, path = q.popleft()

        if state == goal:
            return path + [state]

        visited.add(tuple(state))

        for n in get_neighbors(state):
            if tuple(n) not in visited:
                q.append((n, path + [state]))

start = [2,8,3,1,6,4,7,0,5]
solution = bfs(start)

for step in solution:
    print(step)
